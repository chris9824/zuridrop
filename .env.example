# ──────────────────────────────────────────────
# ZuriDrop – Root Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=zuridrop
POSTGRES_PASSWORD=zuridrop_secret
POSTGRES_DB=zuridrop
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

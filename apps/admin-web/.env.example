# ──────────────────────────────────────────────
# ZuriDrop Admin Web – Environment Variables
# ──────────────────────────────────────────────
# Si non défini : URLs relatives → proxy Next.js vers http://localhost:3001
# En prod : définir l'URL complète de l'API (ex: https://api.zuridrop.com)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_NAME=ZuriDrop Admin

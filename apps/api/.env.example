# ──────────────────────────────────────────────
# ZuriDrop API – Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://zuridrop:zuridrop_secret@localhost:5432/zuridrop?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=zuridrop-jwt-super-secret-change-me

# Access token TTL (durée de vie)
# DEV: long pour tester Swagger sans 401 intempestifs
# PROD: court pour la sécurité
ACCESS_TOKEN_TTL_DEV=8h
ACCESS_TOKEN_TTL_PROD=15m

# Refresh token TTL
REFRESH_TOKEN_TTL=30d

# ── Géocodage (Nominatim / OpenStreetMap) ─────────────────
#
# GEOCODING_ENABLED : active le géocodage strict des adresses customer.
#   - false (défaut) : mode test — pas de blocage, fallback si échec ou désactivé.
#   - true : géocodage automatique obligatoire, erreur si adresse introuvable.
#
# Mode test (GEOCODING_ENABLED=false) :
#   Création/modification d'adresse sans blocage. Si géocodage échoue ou est
#   désactivé, des coordonnées de fallback (Abidjan) sont utilisées.
#   Idéal pour dev et démos.
#
# Mode lancement (GEOCODING_ENABLED=true) :
#   Géocodage strict. L'adresse doit être géolocalisable. Erreurs claires
#   en cas d'adresse introuvable ou ambiguë.
#
# GEOCODING_ENABLED=false
# GEOCODING_URL=https://nominatim.openstreetmap.org
# GEOCODING_USER_AGENT=ZuriDrop/1.0 (delivery; https://zuridrop.com)
#
# Coordonnées de fallback (mode test uniquement) :
# GEOCODING_FALLBACK_LAT=5.3364
# GEOCODING_FALLBACK_LON=-4.0267
